# Base URL for the Marketplace mock API.
# Leave unset to use the same-origin Next.js Route Handlers (the default for local dev).
# Set this only if you host the mock API elsewhere.
NEXT_PUBLIC_API_BASE_URL=

# Artificial latency (ms) added to every mock API response so loading states are visible.
# Range is treated as [MOCK_API_MIN_LATENCY_MS, MOCK_API_MAX_LATENCY_MS].
MOCK_API_MIN_LATENCY_MS=350
MOCK_API_MAX_LATENCY_MS=800
